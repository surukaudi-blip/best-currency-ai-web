{
  "version": "1.0",
  "status": "ACTIVE_POLICY",
  "applies_to": ["CRYPTO", "OIL", "GOLD"],
  "purpose": "Require historical diagnostic backtesting and documented model QA before any new asset vertical may be frozen for prospective validation.",
  "stage_order": [
    "A_DATA_AND_SOURCE_ADAPTER",
    "B_EVIDENCE_AND_CONTEXT_LAYER",
    "C_DECISION_INTELLIGENCE",
    "C4_HISTORICAL_BACKTEST",
    "C5_PRE_FREEZE_CROSS_CHECK",
    "D_FREEZE_WATCH_TIMELINE_FRESH_OOS"
  ],
  "backtest_policy": {
    "role": "DIAGNOSTIC_NOT_FINAL_PROOF",
    "historical_data_must_precede_freeze": true,
    "lookahead_bias": "PROHIBITED",
    "future_information_leakage": "PROHIBITED",
    "survivorship_bias": "MUST_BE_ASSESSED_WHERE_APPLICABLE",
    "test_set_tuning": "PROHIBITED",
    "parameter_selection": "MUST_NOT_BE_OPTIMIZED_TO_MAXIMIZE_TEST_SET_OUTCOMES",
    "walk_forward_or_rolling_evaluation": "REQUIRED_WHERE_DATA_DEPTH_ALLOWS",
    "regime_breakdown": "REQUIRED",
    "missing_data_and_source_outage_tests": "REQUIRED",
    "stress_and_edge_case_tests": "REQUIRED",
    "transaction_cost_model": "ONLY_REQUIRED_IF_A_FUTURE_STRATEGY_OR_EXECUTION_LAYER_IS_EVALUATED",
    "trade_execution": "OFF"
  },
  "minimum_backtest_outputs": [
    "sample_start_and_end",
    "observation_count",
    "asset_universe",
    "signal_or_market_view_distribution",
    "decision_readiness_distribution",
    "risk_state_distribution",
    "counter_thesis_activation_rate",
    "reasoner_decision_distribution",
    "directional_hit_rate_for_eligible_states",
    "average_forward_return_by_market_view",
    "median_forward_return_by_market_view",
    "regime_breakdown",
    "stability_by_subperiod",
    "false_confidence_and_failure_cases",
    "missing_or_stale_data_behavior",
    "known_limitations"
  ],
  "pre_freeze_cross_check": {
    "required_checks": [
      "data_integrity",
      "source_integrity_and_licensing",
      "formula_and_weight_concentration",
      "threshold_distribution",
      "risk_model_sanity",
      "counter_thesis_sensitivity",
      "cross_layer_alignment_consistency",
      "edge_cases_and_market_regimes",
      "reasoner_sanity_and_internal_consistency",
      "hidden_trading_bias_check",
      "observability_readiness",
      "outcome_definition_locked_before_freeze",
      "backtest_leakage_review",
      "backtest_stability_review"
    ],
    "decisions": [
      "PASS_FREEZE",
      "PASS_WITH_CONDITIONS_REFINE",
      "FAIL_REDESIGN"
    ],
    "freeze_allowed_only_if": "PASS_FREEZE"
  },
  "evidence_hierarchy": {
    "historical_backtest": "MODEL_DIAGNOSTIC_EVIDENCE",
    "fresh_oos_after_freeze": "PRIMARY_VALIDATION_EVIDENCE",
    "rule": "A strong backtest may justify freezing a stable model, but it must never substitute for prospective Fresh OOS validation."
  }
}
